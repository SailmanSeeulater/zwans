# Copy this file to .env and fill it in. zwans reads .env from the folder you run it from.
# Real environment variables win over values here. .env is gitignored; never commit it.

# Which credential Zwans uses: api_key (billed per token) or subscription (your Claude plan).
ZWANS_AUTH=api_key

# For api_key: create one in the Claude Console. Set a monthly spend limit there too.
ANTHROPIC_API_KEY=

# For subscription: run `claude setup-token`. Check Anthropic's terms before using a plan
# token outside Claude Code.
CLAUDE_CODE_OAUTH_TOKEN=

# Optional. These are the defaults.
# ZWANS_MODEL=claude-opus-5-5
# ZWANS_EFFORT=medium
